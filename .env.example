# Скопируйте в .env и при необходимости поменяйте значения:
#   Linux/macOS:        cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
# Файл .env не попадает в git.

# --- PostgreSQL ---
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=change_me
# Хост для запуска Python-кода с вашего компьютера (не из Docker).
# Внутри docker compose приложение всегда ходит на db:5432.
POSTGRES_HOST=localhost
# Порт, на котором база доступна с вашего компьютера.
# 5433, а не 5432 — чтобы не конфликтовать с локально установленным PostgreSQL.
POSTGRES_PORT=5433

# --- Приложение ---
# Путь к файлу настроек предметной области
WEATHER_CONFIG=config/settings.yaml
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
